# Copy this file to .env for local testing (never commit the real .env).
# Filled in once the Onshape OAuth app is registered and LUNA Parts gives API access.

ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
SESSION_SECRET=

# Optional; defaults to https://build.lunatecs.org/api/v1
LUNA_PARTS_API_BASE=
LUNA_PARTS_API_KEY=

# Who may use the panel: Onshape user IDs and/or emails, separated by commas.
# Empty means nobody can use it. Anyone else sees "This app is only for
# FRC Team 316 LUNATECS" and their Onshape ID, which you can add here.
ALLOWED_ONSHAPE_USERS=
